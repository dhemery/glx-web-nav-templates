{{- define "title" -}}All Persons{{- end -}}

{{- define "content" -}}
    {{- $personsBySurname := .GroupBySurname  -}}
    {{- range $surname, $persons := $personsBySurname -}}
    <h2>{{$surname}}</h2>
    <ul>
        {{- range $persons.Sort -}}
        <li><a href="{{template "entity-path" .}}">{{.}}</a></li>
        {{- end -}}
    </ul>
    {{- end -}}
{{- end -}}
