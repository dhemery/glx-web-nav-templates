{{- define "entity" -}}
    <h2>Fields</h2>
    <table>
        <tr>
            <th>Type</th>
            <td>{{.Type}}</td>
        </tr>
        {{- range .Participants -}}
        <tr>
            <th>{{.Role}}</th>
            <td><a href='/{{.Person.PagePath}}'>{{.Person}}</a></td>
        </tr>
        {{- end -}}
        <tr>
            <th>Start Event</th>
            <td>{{- with .StartEvent -}}<a href='/{{.PagePath}}'>{{.}}</a>{{- end -}}</td>
        </tr>
        <tr>
            <th>End Event</th>
            <td>{{- with .EndEvent -}}<a href='/{{.PagePath}}'>{{.}}</a>{{- end -}}</td>
        </tr>
    </table>

    {{- template "properties" . -}}

    {{- with .Assertions }}
    <h2>Referenced By</h2>
    <h3>Assertions</h3>
    <ul>
        {{- range .Sort -}}
        <li><a href='/{{.PagePath}}'>{{.}}</a></li>
        {{- end -}}
    </ul>
    {{- end -}}

    {{- template "notes" . -}}
{{- end -}}

